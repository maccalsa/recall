# Shared install script metadata. Keep RECALL_VERSION in sync with
# src-tauri/tauri.conf.json → "version".
RECALL_VERSION="0.1.0"
RECALL_APP_NAME="Recall"
RECALL_APP_ID="recall"
RECALL_GITHUB_REPO="maccalsa/recall"

# Debian package name as installed by apt (from the Tauri .deb bundle).
RECALL_DEB_PACKAGE="${RECALL_DEB_PACKAGE:-recall}"
